# Copy to backend/.env

# MongoDB connection (defaults to mongodb://localhost:27017/crowd_platform)
MONGO_URI=mongodb://localhost:27017/crowd_platform

# REQUIRED. Without it the server falls back to a development secret and warns.
JWT_SECRET=

# API port and the origin allowed by CORS
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Local pre-labelling backend
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Optional hosted pre-labelling backend
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
