# Copy to .env in the repository root. Every value here is optional.

# Where the embedded database (PGlite) and trained models live.
DATA_DIR=./data

# Use a real Postgres instead of the embedded one:
# DATABASE_URL=postgres://user:password@localhost:5432/crowd

HOST=127.0.0.1
PORT=4000

# Self-service sign-up creates annotators. Set to false to make accounts admin-only.
ALLOW_REGISTRATION=true
SESSION_TTL_DAYS=14
# Origins allowed to make state-changing requests besides the server's own (the Vite dev server).
TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=true

# Local pre-labelling through Ollama.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Claude, through the official SDK. The model can be changed per project in the UI.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Any OpenAI-compatible server (vLLM, LM Studio, llama.cpp server, a hosted model).
# OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Parallel requests per pre-labelling job, and the per-request timeout.
LLM_CONCURRENCY=2
LLM_TIMEOUT_MS=90000
